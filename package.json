{
  "name": "freewebtools",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 90",
    "edge >= 90",
    "firefox >= 90",
    "safari >= 15",
    "ios >= 15",
    "not dead"
  ],
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "check:image": "node --no-warnings --experimental-strip-types scripts/check-image-processing.mjs",
    "cf-build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/js-yaml": "^4.0.9",
    "@vercel/blob": "^2.6.1",
    "clsx": "^2.1.1",
    "cron-parser": "5.5.0",
    "cronstrue": "3.14.0",
    "diff": "^8.0.2",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "marked": "^17.0.1",
    "next": "^15",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.394",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "uuid": "^13.0.0",
    "xml-formatter": "^3.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^8",
    "eslint-config-next": "^15",
    "postcss": "^8.5.6",
    "typescript": "^5",
    "wrangler": "^4.112.0"
  }
}
