# Production canonical origin. MUST be set in production deployments.
# If unset, SEO canonical URLs, sitemap entries, and OG metadata will fall back
# to http://localhost:3000 — which de-indexes the site.
NEXT_PUBLIC_SITE_URL=https://utils-hub.vercel.app

# Optional: enables the LibreOffice/Collabora-backed PDF Editor.
# Collabora must be able to reach WOPI_PUBLIC_BASE_URL from its server.
# COLLABORA_URL=https://collabora.example.com
# WOPI_PUBLIC_BASE_URL=https://utils-hub.vercel.app
# Connect a private Vercel Blob store; Vercel supplies this token automatically.
# BLOB_READ_WRITE_TOKEN=
# PDF_EDITOR_MAX_BYTES=4000000
# PDF_EDITOR_SESSION_TTL_SECONDS=3600
# Local development without a Blob token falls back to this optional directory.
# PDF_EDITOR_STORAGE_DIR=/tmp/freewebtools-pdf-editor
