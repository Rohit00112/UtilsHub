# Production canonical origin. MUST be set in production deployments.
# Production falls back to https://freewebtools.app; local development falls
# back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://freewebtools.app

# Google Search Console verification token (content="..." value from the HTML-tag
# verification method). Renders <meta name="google-site-verification">.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Analytics loads only
# after the visitor accepts third-party cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: enables the LibreOffice/Collabora-backed PDF Editor.
# Collabora must be able to reach WOPI_PUBLIC_BASE_URL from its server.
# COLLABORA_URL=https://collabora.example.com
# WOPI_PUBLIC_BASE_URL=https://freewebtools.app
# Connect a private Vercel Blob store; Vercel supplies this token automatically.
# BLOB_READ_WRITE_TOKEN=
# PDF_EDITOR_MAX_BYTES=4000000
# PDF_EDITOR_SESSION_TTL_SECONDS=3600
# Local development without a Blob token falls back to this optional directory.
# PDF_EDITOR_STORAGE_DIR=/tmp/freewebtools-pdf-editor
